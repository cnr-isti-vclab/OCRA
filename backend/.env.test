# Test Environment Configuration
# This file is used ONLY during test execution

# PostgreSQL Test Database
# Uses a separate database to avoid contaminating production/dev data
DATABASE_URL="postgresql://ocra_user:ocra_pass@localhost:5432/ocra_test?schema=public"
DATABASE_URL_TEST="postgresql://ocra_user:ocra_pass@localhost:5432/ocra_test?schema=public"

# MongoDB Test Database (replica set required for annotation transactions)
MONGO_URL="mongodb://127.0.0.1:27017/?replicaSet=rs0"
MONGO_AUDIT_DB="ocra_audit_test"
MONGO_AUDIT_COLLECTION="audit"
MONGO_CONTENT_DB="ocra_content_test"

# OAuth/Keycloak (not used in tests, but required by config)
KEYCLOAK_URL="http://localhost:8080"
KEYCLOAK_REALM="demo"
KEYCLOAK_CLIENT_ID="oauth-demo"
KEYCLOAK_CLIENT_SECRET="test-secret"

# Server (not used in tests)
PORT=3002
FRONTEND_URL="http://localhost:3001"

# Test mode flag
NODE_ENV="test"
