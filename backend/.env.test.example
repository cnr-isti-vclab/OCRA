# Test Environment Variables
# Copy this to .env.test for integration tests

# PostgreSQL Test Database
DATABASE_URL="postgresql://ocra:ocra@localhost:5432/ocra_test"
DATABASE_URL_TEST="postgresql://ocra:ocra@localhost:5432/ocra_test"

# MongoDB Test Database
MONGO_URL="mongodb://localhost:27017"
MONGO_DB="ocra_audit_test"
MONGO_COLLECTION="audit_test"

# Test JWT Secret
JWT_SECRET="test-secret-key-do-not-use-in-production"

# Disable external services in tests
NODE_ENV="test"
