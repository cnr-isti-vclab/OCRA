{
  "name": "backend",
  "version": "1.0.0",
  "description": "OAuth session management backend API",
  "main": "server.ts",
  "type": "module",
  "scripts": {
    "start": "tsx server.ts",
    "dev": "tsx watch server.ts",
    "build": "tsc",
    "build:watch": "tsc --watch",
    "seed": "tsx seed.ts",
    "seed:annotation": "tsx ./scripts/create-test-annotation.ts",
    "project:export": "tsx ./scripts/export-project-by-id.ts",
    "prisma:push": "npx prisma db push",
    "prisma:generate": "npx prisma generate",
    "test": "vitest run",
    "test:unit": "vitest run --exclude 'src/test/**'",
    "test:integration": "vitest run src/test/",
    "test:watch": "vitest",
    "test:ui": "vitest --ui",
    "test:coverage": "vitest run --coverage",
    "test:quick": "tsx ./scripts/test-log-audit.ts && tsx ./scripts/test-get-users-stats.ts"
  },
  "dependencies": {
    "@prisma/client": "^5.18.0",
    "@types/n3": "^1.26.1",
    "cors": "^2.8.5",
    "dotenv": "^17.2.3",
    "express": "^4.21.2",
    "extract-zip": "^2.0.1",
    "fs-extra": "^11.3.5",
    "mongodb": "^5.9.0",
    "multer": "^2.0.2",
    "n3": "^1.26.0",
    "shared": "*",
    "swagger-jsdoc": "^6.2.8",
    "swagger-ui-express": "^5.0.0"
  },
  "devDependencies": {
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/fs-extra": "^11.0.4",
    "@types/multer": "^2.0.0",
    "@types/node": "^22.0.0",
    "@types/supertest": "^6.0.3",
    "@types/swagger-jsdoc": "^6.0.4",
    "@types/swagger-ui-express": "^4.1.6",
    "prisma": "^5.18.0",
    "supertest": "^7.1.4",
    "tsx": "^4.7.0",
    "typescript": "^5.9.2"
  },
  "engines": {
    "node": ">=18"
  },
  "overrides": {
    "glob": "^10.3.10",
    "inflight": "npm:@types/inflight@^1.0.0",
    "lodash.get": "npm:lodash@^4.17.21",
    "lodash.isequal": "npm:lodash@^4.17.21"
  }
}
