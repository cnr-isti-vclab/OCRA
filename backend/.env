## Environment variables for the backend

# DEMO_ALL_USERS_CREATOR: if true, all users have a creator role. 
# If false, only users with a specific role will be created. 
# This is useful for demo purposes.
DEMO_ALL_USERS_CREATOR=true


# Keycloak
ISSUER=http://localhost:8081/realms/demo
CLIENT_ID=react-oauth
CLIENT_SECRET=

# Backend
PORT=3002
CORS_ORIGINS=http://localhost:5173,http://localhost:3001,http://localhost:5174,http://localhost:5175

# PostgreSQL (OBBLIGATORIO per Prisma)
#DIRECT_URL=postgresql://postgres:postgres@localhost:5432/oauth_demo?schema=public
#DATABASE_URL=postgresql://postgres:postgres@localhost:5432/oauth_demo?schema=public
DATABASE_URL=postgresql://ocra_user:ocra_pass@localhost:5432/ocra?schema=public
DIRECT_URL=postgresql://ocra_user:ocra_pass@localhost:5432/ocra?schema=public

# Admin opzionale
SYS_ADMIN_EMAIL=admin@ocra.it

# MongoDB per audit (vedi sotto)
MONGO_URL=mongodb://127.0.0.1:27017/?replicaSet=rs0
MONGO_AUDIT_DB=ocra_audit
MONGO_AUDIT_COLLECTION=audit
MONGO_CONTENT_DB=ocra_content

PROJECT_FILES_PATH=../project_files

ECHOES_KB_PUBLIC_TRIPLE_STORE_ID=6a2abf6b5d6646ff24522299
ECHOES_KB_FEDERATED_TRIPLE_STORE_IDS=6a2abf6b5d6646ff24522299,6a2abf8e5d6646ff2452229a,6a2abf9e5d6646ff2452229b,6a2abfad5d6646ff2452229c,6a2c28964d2e6b3a2e4031ea,6a2c33484d2e6b3a2e4031f1,6a38f8482837600a7ac4b9de,6a4cc65d1681d0c11435a1c0

# Comma-separated ECCCH Digital Twin URIs hidden from the HDT and named-graph lists.
# Example: ECHOES_KB_HIDDEN_HDT_URIS=http://echoes-eccch.eu/HDT/demo-1,http://echoes-eccch.eu/HDT/demo-2
ECHOES_KB_HIDDEN_HDT_URIS=
