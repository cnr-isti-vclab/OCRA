      \&quot;label\&quot;: \&quot;Loss of lower jaw (uraeus)\&quot;,\n        \&quot;description\&quot;: \&quot;The lower mandibular portion of this uraeus is not preserved.\&quot;,\n        \&quot;class\&quot;: \&quot;ocra-voc:missingPart\&quot;,\n        \&quot;content\&quot;: {},\n        \&quot;visibilityType\&quot;: \&quot;scene\&quot;,\n        \&quot;visibilityId\&quot;: \&quot;scene_1781505241833\&quot;,\n        \&quot;version\&quot;: 1,\n        \&quot;erasableAt\&quot;: null,\n        \&quot;erasableBy\&quot;: null,\n        \&quot;createdAt\&quot;: \&quot;2026-06-15T07:05:32.613Z\&quot;,\n        \&quot;createdBy\&quot;: \&quot;cmpdyui3t0000lxshmqc2zlp2\&quot;,\n        \&quot;updatedAt\&quot;: \&quot;2026-06-15T09:26:50.173Z\&quot;,\n        \&quot;updatedBy\&quot;: \&quot;cmpdyui3t0000lxshmqc2zlp2\&quot;\n      },\n      {\n        \&quot;id\&quot;: \&quot;ad_4152cf85-4efe-4b23-90f7-fac3d85d9046\&quot;,\n        \&quot;projectId\&quot;: \&quot;cmqeu7cr1000batte885ajo20\&quot;,\n        \&quot;label\&quot;: \&quot;Trimmed edge\&quot;,\n        \&quot;description\&quot;: \&quot;The current outline of the artefact does not correspond to the original decorative layout. Several margins exhibit intentional cut edges that truncate pre-existing ornamental motifs, such as rosettes, indicating that the sheet was trimmed from a larger decorated object.\&quot;,\n        \&quot;class\&quot;: \&quot;ocra-voc:cutting\&quot;,\n        \&quot;content\&quot;: {},\n        \&quot;visibilityType\&quot;: \&quot;scene\&quot;,\n        \&quot;visibilityId\&quot;: \&quot;scene_1781505241833\&quot;,\n        \&quot;version\&quot;: 1,\n        \&quot;erasableAt\&quot;: null,\n        \&quot;erasableBy\&quot;: null,\n        \&quot;createdAt\&quot;: \&quot;2026-06-15T07:04:23.057Z\&quot;,\n        \&quot;createdBy\&quot;: \&quot;cmpdyui3t0000lxshmqc2zlp2\&quot;,\n        \&quot;updatedAt\&quot;: \&quot;2026-06-15T09:21:32.448Z\&quot;,\n        \&quot;updatedBy\&quot;: \&quot;cmpdyui3t0000lxshmqc2zlp2\&quot;\n      },\n      {\n        \&quot;id\&quot;: \&quot;ad_49e24cf4-dd9e-49ec-a961-7cd8774a9d9f\&quot;,\n        \&quot;projectId\&quot;: \&quot;cmqeu7cr1000batte885ajo20\&quot;,\n        \&quot;label\&quot;: \&quot;Fracture\&quot;,\n        \&quot;description\&quot;: \&quot;\&quot;,\n        \&quot;class\&quot;: \&quot;ocra-voc:fracture\&quot;,\n        \&quot;content\&quot;: {},\n        \&quot;visibilityType\&quot;: \&quot;scene\&quot;,\n        \&quot;visibilityId\&quot;: \&quot;scene_1781505241833\&quot;,\n        \&quot;version\&quot;: 1,\n        \&quot;erasableAt\&quot;: null,\n        \&quot;erasableBy\&quot;: null,\n        \&quot;createdAt\&quot;: \&quot;2026-06-15T07:00:48.111Z\&quot;,\n        \&quot;createdBy\&quot;: \&quot;cmpdyui3t0000lxshmqc2zlp2\&quot;,\n        \&quot;updatedAt\&quot;: \&quot;2026-06-15T09:13:05.602Z\&quot;,\n        \&quot;updatedBy\&quot;: \&quot;cmpdyui3t0000lxshmqc2zlp2\&quot;\n      },\n      {\n        \&quot;id\&quot;: \&quot;ad_62fff67a-4e93-44e3-a8df-dc26eb1084b7\&quot;,\n        \&quot;projectId\&quot;: \&quot;cmqeu7cr1000batte885ajo20\&quot;,\n        \&quot;label\&quot;: \&quot;Lacuna\&quot;,\n        \&quot;description\&quot;: \&quot;\&quot;,\n        \&quot;class\&quot;: \&quot;ocra-voc:lacuna\&quot;,\n        \&quot;content\&quot;: {},\n        \&quot;visibilityType\&quot;: \&quot;scene\&quot;,\n        \&quot;visibilityId\&quot;: \&quot;scene_1781505241833\&quot;,\n        \&quot;version\&quot;: 1,\n        \&quot;erasableAt\&quot;: null,\n        \&quot;erasableBy\&quot;: null,\n        \&quot;createdAt\&quot;: \&quot;2026-06-15T06:36:01.527Z\&quot;,\n        \&quot;createdBy\&quot;: \&quot;cmpdyui3t0000lxshmqc2zlp2\&quot;,\n        \&quot;updatedAt\&quot;: \&quot;2026-06-15T09:08:59.517Z\&quot;,\n        \&quot;updatedBy\&quot;: \&quot;cmpdyui3t0000lxshmqc2zlp2\&quot;\n      },\n      {\n        \&quot;id\&quot;: \&quot;ad_63af72d3-5742-4c4b-a719-ee4595845d1d\&quot;,\n        \&quot;projectId\&quot;: \&quot;cmqeu7cr1000batte885ajo20\&quot;,\n        \&quot;label\&quot;: \&quot;Reassembled fragmented area\&quot;,\n        \&quot;description\&quot;: \&quot;One portion of the artefact is severely fragmented. In this area, the restoration process consisted solely of the spatial reassembly of the surviving fragments, which were repositioned adjacent to one another according to their original arrangement, without physical reintegration of the missing areas.\&quot;,\n        \&quot;class\&quot;: \&quot;ocra-voc:fragmentary\&quot;,\n        \&quot;content\&quot;: {},\n        \&quot;visibilityType\&quot;: \&quot;scene\&quot;,\n        \&quot;visibilityId\&quot;: \&quot;scene_1781505241833\&quot;,\n        \&quot;version\&quot;: 1,\n        \&quot;erasableAt\&quot;: null,\n        \&quot;erasableBy\&quot;: null,\n        \&quot;createdAt\&quot;: \&quot;2026-06-15T07:03:22.113Z\&quot;,\n        \&quot;createdBy\&quot;: \&quot;cmpdyui3t0000lxshmqc2zlp2\&quot;,\n        \&quot;updatedAt\&quot;: \&quot;2026-06-15T09:18:22.118Z\&quot;,\n        \&quot;updatedBy\&quot;: \&quot;cmpdyui3t0000lxshmqc2zlp2\&quot;\n      },\n      {\n        \&quot;id\&quot;: \&quot;ad_6ae3ef8d-99ce-4cb7-9b47-5d8aeeb415c7\&quot;,\n        \&quot;projectId\&quot;: \&quot;cmqeu7cr1000batte885ajo20\&quot;,\n        \&quot;label\&quot;: \&quot;Fracture\&quot;,\n        \&quot;description\&quot;: \&quot;\&quot;,\n        \&quot;class\&quot;: \&quot;ocra-voc:fracture\&quot;,\n        \&quot;content\&quot;: {},\n        \&quot;visibilityType\&quot;: \&quot;scene\&quot;,\n        \&quot;visibilityId\&quot;: \&quot;scene_1781505241833\&quot;,\n        \&quot;version\&quot;: 1,\n        \&quot;erasableAt\&quot;: null,\n        \&quot;erasableBy\&quot;: null,\n        \&quot;createdAt\&quot;: \&quot;2026-06-15T07:02:25.101Z\&quot;,\n        \&quot;createdBy\&quot;: \&quot;cmpdyui3t0000lxshmqc2zlp2\&quot;,\n        \&quot;updatedAt\&quot;: \&quot;2026-06-15T09:14:21.063Z\&quot;,\n        \&quot;updatedBy\&quot;: \&quot;cmpdyui3t0000lxshmqc2zlp2\&quot;\n      },\n      {\n        \&quot;id\&quot;: \&quot;ad_6c6cfacb-ec2d-40a4-889d-cd25ed447e40\&quot;,\n        \&quot;projectId\&quot;: \&quot;cmqeu7cr1000batte885ajo20\&quot;,\n        \&quot;label\&quot;: \&quot;Lacuna\&quot;,\n        \&quot;description\&quot;: \&quot;\&quot;,\n        \&quot;class\&quot;: \&quot;ocra-voc:lacuna\&quot;,\n        \&quot;content\&quot;: {},\n        \&quot;visibilityType\&quot;: \&quot;scene\&quot;,\n        \&quot;visibilityId\&quot;: \&quot;scene_1781505241833\&quot;,\n        \&quot;version\&quot;: 1,\n        \&quot;erasableAt\&quot;: null,\n        \&quot;erasableBy\&quot;: null,\n        \&quot;createdAt\&quot;: \&quot;2026-06-15T06:34:32.817Z\&quot;,\n        \&quot;createdBy\&quot;: \&quot;cmpdyui3t0000lxshmqc2zlp2\&quot;,\n        \&quot;updatedAt\&quot;: \&quot;2026-06-15T09:08:22.696Z\&quot;,\n        \&quot;updatedBy\&quot;: \&quot;cmpdyui3t0000lxshmqc2zlp2\&quot;\n      },\n      {\n        \&quot;id\&quot;: \&quot;ad_7efb9834-e816-424d-86fd-f04a15624feb\&quot;,\n        \&quot;projectId\&quot;: \&quot;cmqeu7cr1000batte885ajo20\&quot;,\n        \&quot;label\&quot;: \&quot;Punic Appliqué Ornament\&quot;,\n        \&quot;description\&quot;: \&quot;Silver sheet ornament from the Punic Necropolis of Sant&apos;Antioco (Tomb of the Winged Goddess), dated between the mid-4th and 3rd centuries BCE. The artefact consists of a circular silver foil decorated with Egyptianizing motifs, including a solar disk flanked by two uraei. The ornament was originally sewn onto a high-status wool garment woven with white and purple threads. The decorative programme was executed using repoussé and chasing techniques, likely with the aid of a pitch support. The sheet is currently heavily corroded and fragmented, exhibiting numerous losses, fractures, and areas of incomplete preservation. The artefact is considered unique within the presently known corpus of Punic metalwork and is still under scholarly investigation.\&quot;,\n        \&quot;class\&quot;: \&quot;ocra:generalDescription\&quot;,\n        \&quot;content\&quot;: {},\n        \&quot;visibilityType\&quot;: \&quot;scene\&quot;,\n        \&quot;visibilityId\&quot;: \&quot;scene_1781505241833\&quot;,\n        \&quot;version\&quot;: 2,\n        \&quot;erasableAt\&quot;: null,\n        \&quot;erasableBy\&quot;: null,\n        \&quot;createdAt\&quot;: \&quot;2026-06-15T07:07:33.606Z\&quot;,\n        \&quot;createdBy\&quot;: \&quot;cmpdyui3t0000lxshmqc2zlp2\&quot;,\n        \&quot;updatedAt\&quot;: \&quot;2026-06-17T09:27:20.218Z\&quot;,\n        \&quot;updatedBy\&quot;: \&quot;cmpdyuuwk0003lxshwm8gv2be\&quot;\n      },\n      {\n        \&quot;id\&quot;: \&quot;ad_866e860e-7b54-4cd0-b0a7-b17d1a47fa47\&quot;,\n        \&quot;projectId\&quot;: \&quot;cmqeu7cr1000batte885ajo20\&quot;,\n        \&quot;label\&quot;: \&quot;Lacuna\&quot;,\n        \&quot;description\&quot;: \&quot;\&quot;,\n        \&quot;class\&quot;: \&quot;ocra-voc:lacuna\&quot;,\n        \&quot;content\&quot;: {},\n        \&quot;visibilityType\&quot;: \&quot;scene\&quot;,\n        \&quot;visibilityId\&quot;: \&quot;scene_1781505241833\&quot;,\n        \&quot;version\&quot;: 1,\n        \&quot;erasableAt\&quot;: null,\n        \&quot;erasableBy\&quot;: null,\n        \&quot;createdAt\&quot;: \&quot;2026-06-15T06:35:45.278Z\&quot;,\n        \&quot;createdBy\&quot;: \&quot;cmpdyui3t0000lxshmqc2zlp2\&quot;,\n        \&quot;updatedAt\&quot;: \&quot;2026-06-15T09:08:45.913Z\&quot;,\n        \&quot;updatedBy\&quot;: \&quot;cmpdyui3t0000lxshmqc2zlp2\&quot;\n      },\n      {\n        \&quot;id\&quot;: \&quot;ad_9412285e-a782-4e8f-985e-05e1b4bf2fa4\&quot;,\n        \&quot;projectId\&quot;: \&quot;cmqeu7cr1000batte885ajo20\&quot;,\n        \&quot;label\&quot;: \&quot;Lacuna\&quot;,\n        \&quot;description\&quot;: \&quot;\&quot;,\n        \&quot;class\&quot;: \&quot;ocra-voc:lacuna\&quot;,\n        \&quot;content\&quot;: {},\n        \&