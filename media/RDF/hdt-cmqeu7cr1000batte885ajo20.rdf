        &quot;erasableAt&quot;: null,
        &quot;erasableBy&quot;: null,
        &quot;createdAt&quot;: &quot;2026-06-15T07:00:25.500Z&quot;,
        &quot;createdBy&quot;: &quot;cmpdyui3t0000lxshmqc2zlp2&quot;,
        &quot;updatedAt&quot;: &quot;2026-06-15T09:12:18.598Z&quot;,
