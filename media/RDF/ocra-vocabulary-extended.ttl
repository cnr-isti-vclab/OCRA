    ocra:defaultColor "#3498DB"^^xsd:string .

ocra-voc:stamping
    a skos:Concept ;
    skos:inScheme ocra-voc:CulturalHeritageAnnotationVocabulary ;
    skos:broader ocra-voc:surfaceFeature ;
    skos:prefLabel "Stamps / hallmarks"@en ;
    skos:prefLabel "Punzonature / marchi"@it ;
    skos:scopeNote "Impressed marks, stamps, or hallmarks used to identify workshop, maker, quality, ownership, or control."@en ;
    skos:scopeNote "Marchi impressi, punzoni o bolli usati per identificare bottega, autore, qualita, proprieta o controllo."@it ;
    skos:closeMatch aat:300028767 ;
    ocra:defaultColor "#3498DB"^^xsd:string .

ocra-voc:fingerprint
    a skos:Concept ;
    skos:inScheme ocra-voc:CulturalHeritageAnnotationVocabulary ;
    skos:broader ocra-voc:surfaceFeature ;
    skos:prefLabel "Fingerprint"@en ;
    skos:prefLabel "Impronta digitale"@it ;
    skos:scopeNote "Visible fingerprint mark preserved on the surface, whether ancient, modern, intentional, or accidental."@en ;
    skos:scopeNote "Impronta digitale visibile conservata sulla superficie, antica o moderna, intenzionale o accidentale."@it ;
    skos:exactMatch aat:300251471 ;
    ocra:defaultColor "#3498DB"^^xsd:string .

ocra-voc:toolmarks
    a skos:Concept ;
    skos:inScheme ocra-voc:CulturalHeritageAnnotationVocabulary ;
    skos:broader ocra-voc:surfaceFeature ;
    skos:prefLabel "Tool marks"@en ;
    skos:prefLabel "Tracce di lavorazione"@it ;
    skos:scopeNote "Marks left on the surface by tools during manufacture, finishing, or later intervention."@en ;
    skos:scopeNote "Tracce lasciate sulla superficie dagli strumenti durante manifattura, finitura o interventi successivi."@it ;
    skos:exactMatch aat:300379817 ;
    ocra:defaultColor "#3498DB"^^xsd:string .

ocra-voc:surfaceTexture
    a skos:Concept ;
    skos:inScheme ocra-voc:CulturalHeritageAnnotationVocabulary ;
    skos:broader ocra-voc:surfaceFeature ;
    skos:prefLabel "Surface texture"@en ;
    skos:prefLabel "Texture superficiale"@it ;
    skos:scopeNote "Observable tactile or visual quality of the surface, such as smoothness, roughness, or granularity."@en ;
    skos:scopeNote "Qualita tattile o visiva osservabile della superficie, come levigatezza, rugosita o granularita."@it ;
    skos:exactMatch aat:300219406 ;
    ocra:defaultColor "#3498DB"^^xsd:string .

ocra-voc:scratches
    a skos:Concept ;
    skos:inScheme ocra-voc:CulturalHeritageAnnotationVocabulary ;
    skos:broader ocra-voc:surfaceFeature ;
    skos:prefLabel "Scratches"@en ;
    skos:prefLabel "Graffi"@it ;
    skos:scopeNote "Narrow linear abrasions or incisions on the surface caused by contact with a sharp or hard object."@en ;
    skos:scopeNote "Abrasioni o incisioni lineari strette sulla superficie causate dal contatto con un oggetto duro o tagliente."@it ;
    ocra:defaultColor "#3498DB"^^xsd:string .

ocra-voc:pittingCondition
    a skos:Concept ;
    skos:inScheme ocra-voc:CulturalHeritageAnnotationVocabulary ;
    skos:broader ocra-voc:surfaceFeature ;
    skos:prefLabel "Pitting"@en ;
    skos:prefLabel "Vaiolatura / puntinatura"@it ;
    skos:scopeNote "Surface marked by small pits or cavities, often associated with corrosion or loss of material."@en ;
    skos:scopeNote "Superficie caratterizzata da piccole cavita o fosse, spesso associate a corrosione o perdita di materiale."@it ;
    skos:exactMatch aat:300054130 ;
    ocra:defaultColor "#3498DB"^^xsd:string .

ocra-voc:weld
    a skos:Concept ;
    skos:inScheme ocra-voc:CulturalHeritageAnnotationVocabulary ;
    skos:broader ocra-voc:surfaceFeature ;
    skos:prefLabel "Weld / join"@en ;
    skos:prefLabel "Giunzione / saldatura originale"@it ;
    skos:scopeNote "Visible original seam, weld, or join connecting two parts of the object."@en ;
    skos:scopeNote "Linea di giunzione, saldatura o unione originale visibile che collega due parti dell'oggetto."@it ;
    ocra:defaultColor "#3498DB"^^xsd:string .

ocra-voc:repair
    a skos:Concept ;
    skos:inScheme ocra-voc:CulturalHeritageAnnotationVocabulary ;
    skos:broader ocra-voc:surfaceFeature ;
    skos:prefLabel "Repair (ancient)"@en ;
    skos:prefLabel "Riparazione antica"@it ;
    skos:scopeNote "Evidence of a historical repair executed before the modern conservation history of the object."@en ;
    skos:scopeNote "Evidenza di una riparazione storica eseguita prima della moderna storia conservativa dell'oggetto."@it ;
    ocra:defaultColor "#3498DB"^^xsd:string .

