# DECORATION (original + extended)
# ============================================================

ocra-voc:motifs
    a skos:Concept ;
    skos:inScheme ocra-voc:CulturalHeritageAnnotationVocabulary ;
    skos:broader ocra-voc:decoration ;
    skos:prefLabel "Motifs"@en ;
    skos:prefLabel "Motivi ornamentali"@it ;
    skos:scopeNote "Decorative units or repeated ornamental forms used in the visual design of the object."@en ;
    skos:scopeNote "Unita decorative o forme ornamentali ripetute impiegate nel disegno visivo dell'oggetto."@it ;
    skos:exactMatch aat:300009700 ;
    ocra:defaultColor "#9B59B6"^^xsd:string .

ocra-voc:engraving
    a skos:Concept ;
    skos:inScheme ocra-voc:CulturalHeritageAnnotationVocabulary ;
    skos:broader ocra-voc:decoration ;
    skos:prefLabel "Engraving"@en ;
    skos:prefLabel "Incisione"@it ;
    skos:scopeNote "Decoration created by cutting or incising lines into the surface with a tool."@en ;
    skos:scopeNote "Decorazione realizzata incidendo o scavando linee nella superficie con uno strumento."@it ;
    skos:exactMatch aat:300053225 ;
    ocra:defaultColor "#9B59B6"^^xsd:string .

ocra-voc:chasing
    a skos:Concept ;
    skos:inScheme ocra-voc:CulturalHeritageAnnotationVocabulary ;
    skos:broader ocra-voc:decoration ;
    skos:prefLabel "Chasing"@en ;
    skos:prefLabel "Cesellatura"@it ;
    skos:scopeNote "Decoration produced by working the front surface with tools to refine or model relief details."@en ;
    skos:scopeNote "Decorazione ottenuta lavorando la superficie frontale con strumenti per rifinire o modellare i dettagli a rilievo."@it ;
    ocra:defaultColor "#9B59B6"^^xsd:string .

ocra-voc:repoussé
    a skos:Concept ;
    skos:inScheme ocra-voc:CulturalHeritageAnnotationVocabulary ;
    skos:broader ocra-voc:decoration ;
    skos:prefLabel "Repoussé"@en ;
    skos:prefLabel "Sbalzo / repoussé"@it ;
    skos:scopeNote "Decoration or modeling created by hammering the reverse side to raise forms in relief on the front."@en ;
    skos:scopeNote "Decorazione o modellato creati martellando il retro per sollevare forme in rilievo sul fronte."@it ;
    ocra:defaultColor "#9B59B6"^^xsd:string .

ocra-voc:punchwork
    a skos:Concept ;
    skos:inScheme ocra-voc:CulturalHeritageAnnotationVocabulary ;
    skos:broader ocra-voc:decoration ;
    skos:prefLabel "Punchwork"@en ;
    skos:prefLabel "Punzonatura decorativa"@it ;
    skos:scopeNote "Decoration created with repeated impressions made by punches or similar tools."@en ;
    skos:scopeNote "Decorazione ottenuta con impressioni ripetute realizzate mediante punzoni o strumenti simili."@it ;
    skos:exactMatch aat:300186214 ;
    ocra:defaultColor "#9B59B6"^^xsd:string .

ocra-voc:inlay
    a skos:Concept ;
    skos:inScheme ocra-voc:CulturalHeritageAnnotationVocabulary ;
    skos:broader ocra-voc:decoration ;
    skos:prefLabel "Inlay"@en ;
    skos:prefLabel "Intarsio"@it ;
