@prefix ocra-voc: <https://ocra.example.org/vocabulary/> .
@prefix ocra:     <https://ocra.example.org/ontology/> .
@prefix aat:      <http://vocab.getty.edu/aat/> .
@prefix wd:       <http://www.wikidata.org/entity/> .
@prefix skos:     <http://www.w3.org/2004/02/skos/core#> .
@prefix xsd:      <http://www.w3.org/2001/XMLSchema#> .

# Mapping policy:
# - Use skos:exactMatch only when Getty AAT or Wikidata exposes a concept
#   that is semantically equivalent to the local OCRA concept.
# - Use skos:closeMatch when the external concept is only approximate,
#   broader, narrower, or phrased differently but still useful for alignment.
# - Keep the detailed local OCRA concept even when no trustworthy external
#   match exists yet; never force a false exactMatch.

ocra-voc:CulturalHeritageAnnotationVocabulary
    a skos:ConceptScheme ;
    skos:prefLabel "OCRA vocabulary for cultural heritage annotation"@en ;
    skos:prefLabel "Vocabolario OCRA per l'annotazione del patrimonio culturale"@it ;
    skos:scopeNote "Example concept scheme for annotating cultural heritage objects in OCRA. The vocabulary is intentionally limited but extensible during use. When possible, local concepts should be aligned with broader external vocabularies such as Getty AAT, Wikidata, or other relevant knowledge organization systems."@en ;
    skos:scopeNote "Schema di concetti di esempio per annotare beni culturali in OCRA. Il vocabolario e' intenzionalmente limitato ma puo' essere ampliato durante l'uso. Quando possibile, i concetti locali dovrebbero essere allineati a vocabolari esterni piu' ampi, come Getty AAT, Wikidata o altri sistemi di organizzazione della conoscenza pertinenti."@it .

ocra:defaultColor
    a <http://www.w3.org/1999/02/22-rdf-syntax-ns#Property> ;
    skos:prefLabel "default display color"@en ;
    skos:prefLabel "colore di visualizzazione predefinito"@it .

# ============================================================
# TOP CONCEPTS
# ============================================================

ocra-voc:conditionAlteration
    a skos:Concept ;
    skos:inScheme ocra-voc:CulturalHeritageAnnotationVocabulary ;
    skos:prefLabel "Condition / alteration"@en ;
    skos:prefLabel "Stato conservativo / alterazione"@it ;
    ocra:defaultColor "#999999"^^xsd:string .

ocra-voc:lossDamage
    a skos:Concept ;
    skos:inScheme ocra-voc:CulturalHeritageAnnotationVocabulary ;
    skos:prefLabel "Loss / damage"@en ;
    skos:prefLabel "Mancanza / danno"@it ;
    ocra:defaultColor "#E74C3C"^^xsd:string .

ocra-voc:surfaceFeature
    a skos:Concept ;
    skos:inScheme ocra-voc:CulturalHeritageAnnotationVocabulary ;
    skos:prefLabel "Surface feature"@en ;
    skos:prefLabel "Caratteristica superficiale"@it ;
    ocra:defaultColor "#3498DB"^^xsd:string .

ocra-voc:decoration
    a skos:Concept ;
    skos:inScheme ocra-voc:CulturalHeritageAnnotationVocabulary ;
    skos:prefLabel "Decoration"@en ;
    skos:prefLabel "Decorazione"@it ;
    ocra:defaultColor "#9B59B6"^^xsd:string .

ocra-voc:techniqueFinish
    a skos:Concept ;
    skos:inScheme ocra-voc:CulturalHeritageAnnotationVocabulary ;
    skos:prefLabel "Technique / finish"@en ;
    skos:prefLabel "Tecnica / finitura"@it ;
    ocra:defaultColor "#F1C40F"^^xsd:string .

ocra-voc:conservationTreatment
    a skos:Concept ;
    skos:inScheme ocra-voc:CulturalHeritageAnnotationVocabulary ;
    skos:prefLabel "Conservation treatment"@en ;
    skos:prefLabel "Intervento conservativo"@it ;
    ocra:defaultColor "#27AE60"^^xsd:string .

ocra-voc:materialComposition
    a skos:Concept ;
    skos:inScheme ocra-voc:CulturalHeritageAnnotationVocabulary ;
    skos:prefLabel "Material / composition"@en ;
    skos:prefLabel "Materiale / composizione"@it ;
    ocra:defaultColor "#1ABC9C"^^xsd:string .

