# ============================================================
# SCIENTIFIC EXAMINATION — analysis and documentation methods
# ============================================================

ocra-voc:scientificExamination
    a skos:Concept ;
    skos:inScheme ocra-voc:CulturalHeritageAnnotationVocabulary ;
    skos:prefLabel "Scientific examination"@en ;
    skos:prefLabel "Esame scientifico"@it ;
    skos:scopeNote "Category for analytical, imaging, and documentation methods used to investigate the object materially and structurally."@en ;
    skos:scopeNote "Categoria per metodi analitici, di imaging e di documentazione usati per indagare l'oggetto sotto il profilo materiale e strutturale."@it ;
    ocra:defaultColor "#3498DB"^^xsd:string .

ocra-voc:rtiExamination
    a skos:Concept ;
    skos:inScheme ocra-voc:CulturalHeritageAnnotationVocabulary ;
    skos:broader ocra-voc:scientificExamination ;
    skos:prefLabel "Reflectance Transformation Imaging (RTI)"@en ;
    skos:prefLabel "Esame RTI (Reflectance Transformation Imaging)"@it ;
    skos:exactMatch aat:300390594 ;
    skos:scopeNote "Computational photography method that enables interactive relighting of a surface to reveal detail"@en ;
    skos:scopeNote "Metodo di fotografia computazionale che consente di variare interattivamente l'illuminazione della superficie per rivelarne i dettagli"@it ;
    ocra:defaultColor "#3498DB"^^xsd:string .

ocra-voc:scanning3D
    a skos:Concept ;
    skos:inScheme ocra-voc:CulturalHeritageAnnotationVocabulary ;
    skos:broader ocra-voc:scientificExamination ;
    skos:prefLabel "3D scanning"@en ;
    skos:prefLabel "Scansione 3D"@it ;
    skos:scopeNote "Three-dimensional capture method used to record the geometry and surface morphology of the object."@en ;
    skos:scopeNote "Metodo di acquisizione tridimensionale usato per registrare la geometria e la morfologia superficiale dell'oggetto."@it ;
    ocra:defaultColor "#3498DB"^^xsd:string .

ocra-voc:xrayExamination
    a skos:Concept ;
    skos:inScheme ocra-voc:CulturalHeritageAnnotationVocabulary ;
    skos:broader ocra-voc:scientificExamination ;
    skos:prefLabel "X-ray examination"@en ;
    skos:prefLabel "Radiografia X"@it ;
    skos:scopeNote "Radiographic examination used to visualize internal structure, joins, fractures, or hidden features."@en ;
    skos:scopeNote "Esame radiografico usato per visualizzare struttura interna, giunzioni, fratture o caratteristiche nascoste."@it ;
    ocra:defaultColor "#3498DB"^^xsd:string .

ocra-voc:xrfAnalysis
    a skos:Concept ;
    skos:inScheme ocra-voc:CulturalHeritageAnnotationVocabulary ;
    skos:broader ocra-voc:scientificExamination ;
    skos:prefLabel "X-ray fluorescence (XRF)"@en ;
    skos:prefLabel "Fluorescenza a raggi X (XRF)"@it ;
    skos:scopeNote "Non-destructive elemental analysis technique for identifying metal alloy composition"@en ;
    skos:scopeNote "Tecnica di analisi elementale non distruttiva per la caratterizzazione delle leghe metalliche"@it ;
    ocra:defaultColor "#3498DB"^^xsd:string .

ocra-voc:multispectralImaging
    a skos:Concept ;
    skos:inScheme ocra-voc:CulturalHeritageAnnotationVocabulary ;
    skos:broader ocra-voc:scientificExamination ;
    skos:prefLabel "Multispectral imaging"@en ;
    skos:prefLabel "Imaging multispettrale"@it ;
    skos:scopeNote "Imaging method that records the object in multiple spectral bands to reveal materials, alterations, or hidden details."@en ;
    skos:scopeNote "Metodo di imaging che registra l'oggetto in piu bande spettrali per rivelare materiali, alterazioni o dettagli nascosti."@it ;
    skos:exactMatch aat:300380539 ;
    ocra:defaultColor "#3498DB"^^xsd:string .

ocra-voc:photogrammetry
    a skos:Concept ;
    skos:inScheme ocra-voc:CulturalHeritageAnnotationVocabulary ;
    skos:broader ocra-voc:scientificExamination ;
    skos:prefLabel "Photogrammetry"@en ;
    skos:prefLabel "Fotogrammetria"@it ;
    skos:scopeNote "Method for deriving measurements, models, or spatial documentation from overlapping photographic images."@en ;
    skos:scopeNote "Metodo per ricavare misure, modelli o documentazione spaziale da immagini fotografiche sovrapposte."@it ;
    skos:exactMatch aat:300053580 ;
    ocra:defaultColor "#3498DB"^^xsd:string .
