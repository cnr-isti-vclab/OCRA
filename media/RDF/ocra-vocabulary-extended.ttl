    skos:scopeNote "Motivi rappresentativi, simboli, figure e immagini tematiche che veicolano significati o tradizioni riconoscibili."@it ;
    skos:exactMatch aat:300055859 ;
    ocra:defaultColor "#9B59B6"^^xsd:string .

