# ============================================================
# ICONOGRAPHY — motivi iconografici
# Strategia di allineamento:
#   - AAT (skos:exactMatch) dove esiste record autonomo verificato
#   - Wikidata (skos:exactMatch / skos:closeMatch) per simboli
#     non coperti dall'AAT come concetti autonomi
#   - skos:scopeNote segnala i casi in cui il Getty IA
#     potrà in futuro sostituire/affiancare il QID Wikidata
# ============================================================

ocra-voc:iconography
    a skos:Concept ;
    skos:inScheme ocra-voc:ConservationAnnotationVocabulary ;
    skos:broader ocra-voc:decoration ;
    skos:prefLabel "Iconography"@en ;
    skos:prefLabel "Iconografia"@it ;
    skos:exactMatch aat:300015638 ;
    ocra:defaultColor "#6C3483"^^xsd:string .

