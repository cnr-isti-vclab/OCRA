@prefix ocra-voc: <https://ocra.example.org/vocabulary/> .
@prefix ocra:     <https://ocra.example.org/ontology/> .
@prefix aat:      <http://vocab.getty.edu/aat/> .
@prefix wd:       <http://www.wikidata.org/entity/> .
@prefix dcterms:  <http://purl.org/dc/terms/> .
@prefix rdfs:     <http://www.w3.org/2000/01/rdf-schema#> .
@prefix skos:     <http://www.w3.org/2004/02/skos/core#> .
@prefix xsd:      <http://www.w3.org/2001/XMLSchema#> .

# Mapping policy:
# - Use skos:exactMatch only when Getty AAT or Wikidata exposes a concept
#   that is semantically equivalent to the local OCRA concept.
# - Use skos:closeMatch when the external concept is only approximate,
#   broader, narrower, or phrased differently but still useful for alignment.
# - Keep the detailed local OCRA concept even when no trustworthy external
#   match exists yet; never force a false exactMatch.

ocra-voc:CulturalHeritageAnnotationVocabulary
    a skos:ConceptScheme ;
    skos:prefLabel "OCRA vocabulary for cultural heritage annotation"@en ;
    skos:prefLabel "Vocabolario OCRA per l'annotazione del patrimonio culturale"@it ;
    skos:scopeNote "Example concept scheme for annotating cultural heritage objects in OCRA. The vocabulary is intentionally limited but extensible during use. When possible, local concepts should be aligned with broader external vocabularies such as Getty AAT, Wikidata, or other relevant knowledge organization systems."@en ;
    skos:scopeNote "Schema di concetti di esempio per annotare beni culturali in OCRA. Il vocabolario e' intenzionalmente limitato ma puo' essere ampliato durante l'uso. Quando possibile, i concetti locali dovrebbero essere allineati a vocabolari esterni piu' ampi, come Getty AAT, Wikidata o altri sistemi di organizzazione della conoscenza pertinenti."@it .

ocra:defaultColor
    a <http://www.w3.org/1999/02/22-rdf-syntax-ns#Property> ;
    skos:prefLabel "default display color"@en ;
    skos:prefLabel "colore di visualizzazione predefinito"@it .

# Descriptive metadata properties aligned with Dublin Core.

ocra:generalDescription
    a <http://www.w3.org/1999/02/22-rdf-syntax-ns#Property> ;
    rdfs:subPropertyOf dcterms:description ;
    skos:prefLabel "general description"@en ;
    skos:prefLabel "descrizione generale"@it ;
    skos:scopeNote "Free-text general description of the cultural heritage object, aligned with Dublin Core description."@en ;
    skos:scopeNote "Descrizione testuale generale del bene culturale, allineata a Dublin Core description."@it ;
    ocra:defaultColor "#5D6D7E"^^xsd:string .

ocra:artisticDescription
    a <http://www.w3.org/1999/02/22-rdf-syntax-ns#Property> ;
    rdfs:subPropertyOf ocra:generalDescription ;
    skos:prefLabel "artistic description"@en ;
    skos:prefLabel "descrizione artistica"@it ;
    skos:scopeNote "Free-text note describing style, visual language, iconographic reading, or other art-historical aspects of the object."@en ;
    skos:scopeNote "Nota testuale che descrive stile, linguaggio figurativo, lettura iconografica o altri aspetti storico-artistici del bene."@it ;
    ocra:defaultColor "#5D6D7E"^^xsd:string .

ocra:historicalDescription
    a <http://www.w3.org/1999/02/22-rdf-syntax-ns#Property> ;
    rdfs:subPropertyOf ocra:generalDescription ;
    skos:prefLabel "historical description"@en ;
    skos:prefLabel "descrizione storica"@it ;
    skos:scopeNote "Free-text note for chronology, historical context, use history, provenance summary, or other historically relevant information."@en ;
    skos:scopeNote "Nota testuale per cronologia, contesto storico, storia d'uso, sintesi della provenienza o altre informazioni storicamente rilevanti."@it ;
    ocra:defaultColor "#5D6D7E"^^xsd:string .

ocra:technicalDescription
    a <http://www.w3.org/1999/02/22-rdf-syntax-ns#Property> ;
    rdfs:subPropertyOf ocra:generalDescription ;
    skos:prefLabel "technical description"@en ;
    skos:prefLabel "descrizione tecnico-materiale"@it ;
    skos:scopeNote "Free-text note describing manufacture, materials, construction, or other technical features not already captured by controlled terms."@en ;
    skos:scopeNote "Nota testuale che descrive manifattura, materiali, costruzione o altre caratteristiche tecniche non gia catturate da termini controllati."@it ;
    ocra:defaultColor "#5D6D7E"^^xsd:string .

# ============================================================
# TOP CONCEPTS
# ============================================================

ocra-voc:conditionAlteration
    a skos:Concept ;
    skos:inScheme ocra-voc:CulturalHeritageAnnotationVocabulary ;
    skos:prefLabel "Condition / alteration"@en ;
    skos:prefLabel "Stato conservativo / alterazione"@it ;
    skos:scopeNote "General category for observable conditions, deterioration phenomena, and alterations affecting the object or its surface."@en ;
    skos:scopeNote "Categoria generale per condizioni osservabili, fenomeni di degrado e alterazioni che interessano l'oggetto o la sua superficie."@it ;
    ocra:defaultColor "#999999"^^xsd:string .

ocra-voc:lossDamage
    a skos:Concept ;
    skos:inScheme ocra-voc:CulturalHeritageAnnotationVocabulary ;
    skos:prefLabel "Loss / damage"@en ;
    skos:prefLabel "Mancanza / danno"@it ;
    skos:scopeNote "General category for losses of material, fractures, structural failures, and other forms of physical damage affecting the object."@en ;
    skos:scopeNote "Categoria generale per perdite di materiale, fratture, cedimenti strutturali e altre forme di danno fisico che interessano l'oggetto."@it ;
    ocra:defaultColor "#E74C3C"^^xsd:string .

ocra-voc:surfaceFeature
    a skos:Concept ;
    skos:inScheme ocra-voc:CulturalHeritageAnnotationVocabulary ;
    skos:prefLabel "Surface feature"@en ;
    skos:prefLabel "Caratteristica superficiale"@it ;
    skos:scopeNote "General category for marks, traces, textures, and other features visible on the object's surface."@en ;
    skos:scopeNote "Categoria generale per segni, tracce, texture e altre caratteristiche visibili sulla superficie dell'oggetto."@it ;
    ocra:defaultColor "#3498DB"^^xsd:string .

ocra-voc:decoration
    a skos:Concept ;
    skos:inScheme ocra-voc:CulturalHeritageAnnotationVocabulary ;
    skos:prefLabel "Decoration"@en ;
    skos:prefLabel "Decorazione"@it ;
    skos:scopeNote "General category for decorative elements, motifs, iconography, and surface embellishment techniques."@en ;
    skos:scopeNote "Categoria generale per elementi decorativi, motivi, iconografia e tecniche di arricchimento della superficie."@it ;
    ocra:defaultColor "#9B59B6"^^xsd:string .

ocra-voc:techniqueFinish
    a skos:Concept ;
    skos:inScheme ocra-voc:CulturalHeritageAnnotationVocabulary ;
    skos:prefLabel "Technique / finish"@en ;
    skos:prefLabel "Tecnica / finitura"@it ;
    skos:scopeNote "General category for manufacturing techniques, finishing processes, and intentional surface treatments."@en ;
    skos:scopeNote "Categoria generale per tecniche di manifattura, processi di finitura e trattamenti superficiali intenzionali."@it ;
    ocra:defaultColor "#F1C40F"^^xsd:string .

ocra-voc:conservationTreatment
    a skos:Concept ;
    skos:inScheme ocra-voc:CulturalHeritageAnnotationVocabulary ;
    skos:prefLabel "Conservation treatment"@en ;
    skos:prefLabel "Intervento conservativo"@it ;
    skos:scopeNote "General category for conservation actions undertaken to clean, stabilize, reassemble, or otherwise preserve the object."@en ;
    skos:scopeNote "Categoria generale per azioni conservative finalizzate a pulire, stabilizzare, riassemblare o altrimenti preservare l'oggetto."@it ;
    ocra:defaultColor "#27AE60"^^xsd:string .

ocra-voc:materialComposition
    a skos:Concept ;
    skos:inScheme ocra-voc:CulturalHeritageAnnotationVocabulary ;
    skos:prefLabel "Material / composition"@en ;
    skos:prefLabel "Materiale / composizione"@it ;
    skos:scopeNote "General category for the constituent materials of the object or of significant parts of it."@en ;
    skos:scopeNote "Categoria generale per i materiali costitutivi dell'oggetto o di sue parti significative."@it ;
    ocra:defaultColor "#1ABC9C"^^xsd:string .

# ============================================================
# CONDITIONS AND ALTERATIONS (original + extended)
# ============================================================

ocra-voc:rustCondition
    a skos:Concept ;
    skos:inScheme ocra-voc:CulturalHeritageAnnotationVocabulary ;
    skos:broader ocra-voc:conditionAlteration ;
    skos:prefLabel "Rust"@en ;
    skos:prefLabel "Ruggine"@it ;
    skos:scopeNote "Visible iron corrosion products forming on ferrous surfaces, typically reddish or brownish in appearance."@en ;
    skos:scopeNote "Prodotti di corrosione del ferro visibili su superfici ferrose, tipicamente di colore rossastro o brunastro."@it ;
    skos:exactMatch aat:300213355 ;
    ocra:defaultColor "#999999"^^xsd:string .

ocra-voc:corrosionProcess
    a skos:Concept ;
    skos:inScheme ocra-voc:CulturalHeritageAnnotationVocabulary ;
    skos:broader ocra-voc:conditionAlteration ;
    skos:prefLabel "Corrosion"@en ;
    skos:prefLabel "Corrosione"@it ;
    skos:scopeNote "Chemical or electrochemical deterioration of a material through reaction with the surrounding environment."@en ;
    skos:scopeNote "Deterioramento chimico o elettrochimico di un materiale dovuto alla reazione con l'ambiente circostante."@it ;
    skos:exactMatch aat:300054107 ;
    ocra:defaultColor "#999999"^^xsd:string .

ocra-voc:corrosionResidue
    a skos:Concept ;
    skos:inScheme ocra-voc:CulturalHeritageAnnotationVocabulary ;
    skos:broader ocra-voc:conditionAlteration ;
    skos:prefLabel "Corrosion product"@en ;
    skos:prefLabel "Prodotto di corrosione"@it ;
    skos:scopeNote "Residual material generated by corrosion processes and deposited on or replacing parts of the original surface."@en ;
    skos:scopeNote "Materiale residuo generato dai processi di corrosione e depositato sulla superficie o in sostituzione di parti originali."@it ;
    skos:exactMatch aat:300258515 ;
    ocra:defaultColor "#999999"^^xsd:string .

ocra-voc:abrasion
    a skos:Concept ;
    skos:inScheme ocra-voc:CulturalHeritageAnnotationVocabulary ;
    skos:broader ocra-voc:conditionAlteration ;
    skos:prefLabel "Abrasion"@en ;
    skos:prefLabel "Abrasione"@it ;
    skos:scopeNote "Surface wear caused by rubbing, friction, or contact with another material, often resulting in smoothing or loss of detail."@en ;
    skos:scopeNote "Usura superficiale causata da sfregamento, attrito o contatto con un altro materiale, spesso con levigatura o perdita di dettaglio."@it ;
    skos:exactMatch aat:300053077 ;
    ocra:defaultColor "#999999"^^xsd:string .

ocra-voc:wear
    a skos:Concept ;
    skos:inScheme ocra-voc:CulturalHeritageAnnotationVocabulary ;
    skos:broader ocra-voc:conditionAlteration ;
    skos:prefLabel "Wear"@en ;
    skos:prefLabel "Usura"@it ;
    skos:scopeNote "Gradual deterioration caused by repeated handling, use, or environmental exposure over time."@en ;
    skos:scopeNote "Deterioramento graduale causato da uso, manipolazione ripetuta o esposizione ambientale nel tempo."@it ;
    skos:exactMatch aat:300219449 ;
    ocra:defaultColor "#999999"^^xsd:string .

# -- Biodeterioration --

ocra-voc:biodeterioration
    a skos:Concept ;
    skos:inScheme ocra-voc:CulturalHeritageAnnotationVocabulary ;
    skos:broader ocra-voc:conditionAlteration ;
    skos:prefLabel "Biodeterioration"@en ;
    skos:prefLabel "Biodeterioramento"@it ;
    skos:scopeNote "Deterioration caused by biological organisms such as fungi, lichens, algae, bacteria, or plants."@en ;
    skos:scopeNote "Deterioramento causato da organismi biologici come funghi, licheni, alghe, batteri o piante."@it ;
    skos:exactMatch aat:300219639 ;
    ocra:defaultColor "#999999"^^xsd:string .

ocra-voc:biologicalGrowth
    a skos:Concept ;
    skos:inScheme ocra-voc:CulturalHeritageAnnotationVocabulary ;
    skos:broader ocra-voc:biodeterioration ;
    skos:prefLabel "Biological growth"@en ;
    skos:prefLabel "Colonizzazione biologica"@it ;
    skos:scopeNote "Visible growth or colonization by living organisms on the object's surface."@en ;
    skos:scopeNote "Crescita o colonizzazione visibile di organismi viventi sulla superficie dell'oggetto."@it ;
    skos:closeMatch aat:300219639 ;
    ocra:defaultColor "#999999"^^xsd:string .

ocra-voc:moldGrowth
    a skos:Concept ;
    skos:inScheme ocra-voc:CulturalHeritageAnnotationVocabulary ;
    skos:broader ocra-voc:biodeterioration ;
    skos:prefLabel "Mold growth"@en ;
    skos:prefLabel "Muffa"@it ;
    skos:scopeNote "Fungal growth appearing as mold on the surface, often associated with humidity and poor ventilation."@en ;
    skos:scopeNote "Crescita fungina sotto forma di muffa sulla superficie, spesso associata a umidita e scarsa ventilazione."@it ;
    skos:closeMatch aat:300219639 ;
    ocra:defaultColor "#999999"^^xsd:string .

ocra-voc:lichens
    a skos:Concept ;
    skos:inScheme ocra-voc:CulturalHeritageAnnotationVocabulary ;
    skos:broader ocra-voc:biodeterioration ;
    skos:prefLabel "Lichens"@en ;
    skos:prefLabel "Licheni"@it ;
    skos:scopeNote "Lichen colonies adhering to the surface, especially on stone and outdoor materials."@en ;
    skos:scopeNote "Colonie di licheni aderenti alla superficie, soprattutto su pietra e materiali esposti all'aperto."@it ;
    skos:closeMatch aat:300219639 ;
    ocra:defaultColor "#999999"^^xsd:string .

ocra-voc:algae
    a skos:Concept ;
    skos:inScheme ocra-voc:CulturalHeritageAnnotationVocabulary ;
    skos:broader ocra-voc:biodeterioration ;
    skos:prefLabel "Algae"@en ;
    skos:prefLabel "Alghe"@it ;
    skos:scopeNote "Algal growth on the surface, typically encouraged by moisture and light exposure."@en ;
    skos:scopeNote "Crescita di alghe sulla superficie, generalmente favorita da umidita ed esposizione alla luce."@it ;
    skos:closeMatch aat:300219639 ;
    ocra:defaultColor "#999999"^^xsd:string .

# -- Deposits and encrustations --

ocra-voc:deposit
    a skos:Concept ;
    skos:inScheme ocra-voc:CulturalHeritageAnnotationVocabulary ;
    skos:broader ocra-voc:conditionAlteration ;
    skos:prefLabel "Deposit"@en ;
    skos:prefLabel "Deposito"@it ;
    skos:scopeNote "Accumulation of foreign material on the surface of the object."@en ;
    skos:scopeNote "Accumulo di materiale estraneo sulla superficie dell'oggetto."@it ;
    skos:exactMatch aat:300264846 ;
    ocra:defaultColor "#999999"^^xsd:string .

ocra-voc:encrustation
    a skos:Concept ;
    skos:inScheme ocra-voc:CulturalHeritageAnnotationVocabulary ;
    skos:broader ocra-voc:deposit ;
    skos:prefLabel "Encrustation"@en ;
    skos:prefLabel "Incrostazione"@it ;
    skos:scopeNote "Hard, adherent deposit forming a crust on the object's surface."@en ;
    skos:scopeNote "Deposito duro e aderente che forma una crosta sulla superficie dell'oggetto."@it ;
    skos:closeMatch aat:300264846 ;
    ocra:defaultColor "#999999"^^xsd:string .

ocra-voc:soot
    a skos:Concept ;
    skos:inScheme ocra-voc:CulturalHeritageAnnotationVocabulary ;
    skos:broader ocra-voc:deposit ;
    skos:prefLabel "Soot"@en ;
    skos:prefLabel "Fuliggine"@it ;
    skos:scopeNote "Black carbonaceous deposit produced by incomplete combustion and deposited on the surface."@en ;
    skos:scopeNote "Deposito nero carbonioso prodotto da combustione incompleta e depositato sulla superficie."@it ;
    skos:exactMatch aat:300049017 ;
    ocra:defaultColor "#999999"^^xsd:string .

ocra-voc:dust
    a skos:Concept ;
    skos:inScheme ocra-voc:CulturalHeritageAnnotationVocabulary ;
    skos:broader ocra-voc:deposit ;
    skos:prefLabel "Dust"@en ;
    skos:prefLabel "Polvere"@it ;
    skos:scopeNote "Loose particulate matter settled on the surface of the object."@en ;
    skos:scopeNote "Materia particellare sciolta depositata sulla superficie dell'oggetto."@it ;
    skos:exactMatch aat:300014646 ;
    ocra:defaultColor "#999999"^^xsd:string .

ocra-voc:calcareousDeposit
    a skos:Concept ;
    skos:inScheme ocra-voc:CulturalHeritageAnnotationVocabulary ;
    skos:broader ocra-voc:deposit ;
    skos:prefLabel "Calcareous deposit"@en ;
    skos:prefLabel "Deposito calcareo"@it ;
    skos:scopeNote "Deposit rich in calcium compounds, often formed by water circulation or mineral precipitation."@en ;
    skos:scopeNote "Deposito ricco di composti del calcio, spesso formato da circolazione d'acqua o precipitazione minerale."@it ;
    skos:closeMatch aat:300264846 ;
    ocra:defaultColor "#999999"^^xsd:string .

# -- Patina --

ocra-voc:patina
    a skos:Concept ;
    skos:inScheme ocra-voc:CulturalHeritageAnnotationVocabulary ;
    skos:broader ocra-voc:conditionAlteration ;
    skos:prefLabel "Patina"@en ;
    skos:prefLabel "Patina"@it ;
    skos:scopeNote "Surface layer that develops naturally or intentionally over time through aging, use, or chemical treatment."@en ;
    skos:scopeNote "Strato superficiale che si sviluppa naturalmente o intenzionalmente nel tempo per invecchiamento, uso o trattamento chimico."@it ;
    ocra:defaultColor "#999999"^^xsd:string .

ocra-voc:noblePatinaAlt
    a skos:Concept ;
    skos:inScheme ocra-voc:CulturalHeritageAnnotationVocabulary ;
    skos:broader ocra-voc:patina ;
    skos:prefLabel "Noble patina"@en ;
    skos:prefLabel "Patina nobile"@it ;
    skos:scopeNote "Stable and historically valued patina considered compatible with the object's age, material, and conservation significance."@en ;
    skos:scopeNote "Patina stabile e storicamente apprezzata, considerata coerente con l'eta, il materiale e il valore conservativo dell'oggetto."@it ;
    ocra:defaultColor "#999999"^^xsd:string .

ocra-voc:artificialPatina
    a skos:Concept ;
    skos:inScheme ocra-voc:CulturalHeritageAnnotationVocabulary ;
    skos:broader ocra-voc:patina ;
    skos:prefLabel "Artificial patina"@en ;
    skos:prefLabel "Patina artificiale"@it ;
    skos:scopeNote "Patina intentionally produced by treatment or manufacture rather than by natural aging alone."@en ;
    skos:scopeNote "Patina prodotta intenzionalmente tramite trattamento o manifattura, e non solo per invecchiamento naturale."@it ;
    ocra:defaultColor "#999999"^^xsd:string .

# -- Detachment and cohesion loss --

ocra-voc:detachment
    a skos:Concept ;
    skos:inScheme ocra-voc:CulturalHeritageAnnotationVocabulary ;
    skos:broader ocra-voc:conditionAlteration ;
    skos:prefLabel "Detachment"@en ;
    skos:prefLabel "Distacco"@it ;
    skos:scopeNote "Separation of a layer, fragment, or surface component from the underlying material or support."@en ;
    skos:scopeNote "Separazione di uno strato, di un frammento o di una componente superficiale dal materiale o supporto sottostante."@it ;
    skos:closeMatch aat:300264843 ;
    ocra:defaultColor "#999999"^^xsd:string .

ocra-voc:flaking
    a skos:Concept ;
    skos:inScheme ocra-voc:CulturalHeritageAnnotationVocabulary ;
    skos:broader ocra-voc:detachment ;
    skos:prefLabel "Flaking"@en ;
    skos:prefLabel "Scagliatura"@it ;
    skos:scopeNote "Detachment occurring in small flakes or scales from a surface layer."@en ;
    skos:scopeNote "Distacco che avviene in piccole scaglie o lamelle da uno strato superficiale."@it ;
    skos:exactMatch aat:300054129 ;
    ocra:defaultColor "#999999"^^xsd:string .

ocra-voc:peeling
    a skos:Concept ;
    skos:inScheme ocra-voc:CulturalHeritageAnnotationVocabulary ;
    skos:broader ocra-voc:detachment ;
    skos:prefLabel "Peeling"@en ;
    skos:prefLabel "Pellicola sollevata / esfoliazione"@it ;
    skos:scopeNote "Lifting or separation of a thin surface layer in sheets or films."@en ;
    skos:scopeNote "Sollevamento o separazione di un sottile strato superficiale in fogli o pellicole."@it ;
    skos:exactMatch aat:300054127 ;
    ocra:defaultColor "#999999"^^xsd:string .

ocra-voc:blistering
    a skos:Concept ;
    skos:inScheme ocra-voc:CulturalHeritageAnnotationVocabulary ;
    skos:broader ocra-voc:detachment ;
    skos:prefLabel "Blistering"@en ;
    skos:prefLabel "Rigonfiamento / bolla"@it ;
    skos:scopeNote "Raised bubble-like deformation caused by local separation of a surface layer from the substrate."@en ;
    skos:scopeNote "Deformazione rigonfia a bolla causata da un distacco localizzato dello strato superficiale dal supporto."@it ;
    ocra:defaultColor "#999999"^^xsd:string .

ocra-voc:powdering
    a skos:Concept ;
    skos:inScheme ocra-voc:CulturalHeritageAnnotationVocabulary ;
    skos:broader ocra-voc:detachment ;
    skos:prefLabel "Powdering"@en ;
    skos:prefLabel "Polverizzazione / disgregazione"@it ;
    skos:scopeNote "Loss of cohesion causing the surface material to disaggregate into powder or loose grains."@en ;
    skos:scopeNote "Perdita di coesione che porta il materiale superficiale a disgregarsi in polvere o granuli sciolti."@it ;
    ocra:defaultColor "#999999"^^xsd:string .

# -- Efflorescence and salt damage --

ocra-voc:efflorescence
    a skos:Concept ;
    skos:inScheme ocra-voc:CulturalHeritageAnnotationVocabulary ;
    skos:broader ocra-voc:conditionAlteration ;
    skos:prefLabel "Efflorescence"@en ;
    skos:prefLabel "Efflorescenza"@it ;
    skos:scopeNote "Crystalline salt deposit appearing on the surface as salts migrate outward and crystallize."@en ;
    skos:scopeNote "Deposito cristallino di sali che compare sulla superficie quando i sali migrano verso l'esterno e cristallizzano."@it ;
    skos:exactMatch aat:300214748 ;
    ocra:defaultColor "#999999"^^xsd:string .

ocra-voc:saltDamage
    a skos:Concept ;
    skos:inScheme ocra-voc:CulturalHeritageAnnotationVocabulary ;
    skos:broader ocra-voc:conditionAlteration ;
    skos:prefLabel "Salt damage"@en ;
    skos:prefLabel "Danno da sali solubili"@it ;
    skos:scopeNote "Damage caused by the presence, migration, or crystallization of soluble salts within or on the object."@en ;
    skos:scopeNote "Danno causato dalla presenza, migrazione o cristallizzazione di sali solubili all'interno o sulla superficie dell'oggetto."@it ;
    skos:closeMatch aat:300214748 ;
    ocra:defaultColor "#999999"^^xsd:string .

ocra-voc:subflorescence
    a skos:Concept ;
    skos:inScheme ocra-voc:CulturalHeritageAnnotationVocabulary ;
    skos:broader ocra-voc:conditionAlteration ;
    skos:prefLabel "Subflorescence"@en ;
    skos:prefLabel "Subflorescenza / cristallizzazione subsuperficiale"@it ;
    skos:scopeNote "Crystallization of salts beneath the surface, often causing internal pressure and structural damage."@en ;
    skos:scopeNote "Cristallizzazione di sali sotto la superficie, spesso con pressione interna e danni strutturali."@it ;
    skos:closeMatch aat:300214748 ;
    ocra:defaultColor "#999999"^^xsd:string .

# -- Stains and discolouration --

ocra-voc:staining
    a skos:Concept ;
    skos:inScheme ocra-voc:CulturalHeritageAnnotationVocabulary ;
    skos:broader ocra-voc:conditionAlteration ;
    skos:prefLabel "Staining"@en ;
    skos:prefLabel "Macchia / imbrattamento"@it ;
    skos:scopeNote "Localized discoloration or soiling caused by the deposition, absorption, or transfer of foreign substances."@en ;
    skos:scopeNote "Alterazione cromatica o imbrattamento localizzato causato da deposito, assorbimento o trasferimento di sostanze estranee."@it ;
    ocra:defaultColor "#999999"^^xsd:string .

ocra-voc:discolouration
    a skos:Concept ;
    skos:inScheme ocra-voc:CulturalHeritageAnnotationVocabulary ;
    skos:broader ocra-voc:conditionAlteration ;
    skos:prefLabel "Discolouration"@en ;
    skos:prefLabel "Discromia / alterazione cromatica"@it ;
    skos:scopeNote "General alteration of the original color or tonal balance of a material or surface."@en ;
    skos:scopeNote "Alterazione generale del colore originale o dell'equilibrio tonale di un materiale o di una superficie."@it ;
    ocra:defaultColor "#999999"^^xsd:string .

ocra-voc:yellowing
    a skos:Concept ;
    skos:inScheme ocra-voc:CulturalHeritageAnnotationVocabulary ;
    skos:broader ocra-voc:discolouration ;
    skos:prefLabel "Yellowing"@en ;
    skos:prefLabel "Ingiallimento"@it ;
    skos:scopeNote "Discoloration in which the surface or material acquires a yellow tone over time."@en ;
    skos:scopeNote "Discromia in cui la superficie o il materiale assumono nel tempo una tonalita gialla."@it ;
    skos:exactMatch aat:300225196 ;
    ocra:defaultColor "#999999"^^xsd:string .

ocra-voc:blackening
    a skos:Concept ;
    skos:inScheme ocra-voc:CulturalHeritageAnnotationVocabulary ;
    skos:broader ocra-voc:discolouration ;
    skos:prefLabel "Blackening"@en ;
    skos:prefLabel "Annerimento"@it ;
    skos:scopeNote "Discoloration in which the surface darkens to a black or very dark tone."@en ;
    skos:scopeNote "Discromia in cui la superficie scurisce fino a una tonalita nera o molto scura."@it ;
    skos:closeMatch aat:300379491 ;
    ocra:defaultColor "#999999"^^xsd:string .

# -- Oxidation --

ocra-voc:oxidation
    a skos:Concept ;
    skos:inScheme ocra-voc:CulturalHeritageAnnotationVocabulary ;
    skos:broader ocra-voc:conditionAlteration ;
    skos:prefLabel "Oxidation"@en ;
    skos:prefLabel "Ossidazione"@it ;
    skos:scopeNote "Chemical reaction with oxygen that alters the material and may produce visible surface changes."@en ;
    skos:scopeNote "Reazione chimica con l'ossigeno che altera il materiale e puo produrre cambiamenti visibili sulla superficie."@it ;
    skos:exactMatch aat:300220235 ;
    ocra:defaultColor "#999999"^^xsd:string .

ocra-voc:tarnishing
    a skos:Concept ;
    skos:inScheme ocra-voc:CulturalHeritageAnnotationVocabulary ;
    skos:broader ocra-voc:oxidation ;
    skos:prefLabel "Tarnishing"@en ;
    skos:prefLabel "Appannamento / ossidazione superficiale"@it ;
    skos:scopeNote "Superficial dulling or discoloration of metal caused by oxidation or other atmospheric reactions."@en ;
    skos:scopeNote "Opacizzazione o alterazione superficiale del metallo causata da ossidazione o da altre reazioni atmosferiche."@it ;
    ocra:defaultColor "#999999"^^xsd:string .

# -- Deformation --

ocra-voc:deformation
    a skos:Concept ;
    skos:inScheme ocra-voc:CulturalHeritageAnnotationVocabulary ;
    skos:broader ocra-voc:conditionAlteration ;
    skos:prefLabel "Deformation"@en ;
    skos:prefLabel "Deformazione"@it ;
    skos:scopeNote "Change in the original shape, profile, or geometry of the object or one of its parts."@en ;
    skos:scopeNote "Modifica della forma, del profilo o della geometria originale dell'oggetto o di una sua parte."@it ;
    skos:exactMatch aat:300072976 ;
    ocra:defaultColor "#999999"^^xsd:string .

ocra-voc:warping
    a skos:Concept ;
    skos:inScheme ocra-voc:CulturalHeritageAnnotationVocabulary ;
    skos:broader ocra-voc:deformation ;
    skos:prefLabel "Warping"@en ;
    skos:prefLabel "Incurvamento / svergolamento"@it ;
    skos:scopeNote "Deformation involving bending, twisting, or loss of planarity across a broader area."@en ;
    skos:scopeNote "Deformazione che comporta incurvamento, torsione o perdita di planarita su un'area ampia."@it ;
    ocra:defaultColor "#999999"^^xsd:string .

ocra-voc:denting
    a skos:Concept ;
    skos:inScheme ocra-voc:CulturalHeritageAnnotationVocabulary ;
    skos:broader ocra-voc:deformation ;
    skos:prefLabel "Denting"@en ;
    skos:prefLabel "Ammaccatura"@it ;
    skos:scopeNote "Localized depression caused by impact or pressure without complete breakage of the material."@en ;
    skos:scopeNote "Abbassamento localizzato causato da urto o pressione senza rottura completa del materiale."@it ;
    ocra:defaultColor "#999999"^^xsd:string .

# ============================================================
# LOSS AND DAMAGE (original + extended)
# ============================================================

ocra-voc:cracks
    a skos:Concept ;
    skos:inScheme ocra-voc:CulturalHeritageAnnotationVocabulary ;
    skos:broader ocra-voc:lossDamage ;
    skos:prefLabel "Cracks"@en ;
    skos:prefLabel "Fessurazioni"@it ;
    skos:scopeNote "Linear openings or splits in the material that do not necessarily imply complete separation."@en ;
    skos:scopeNote "Aperture o spaccature lineari nel materiale che non implicano necessariamente una separazione completa."@it ;
    skos:exactMatch aat:300209168 ;
    ocra:defaultColor "#E74C3C"^^xsd:string .

ocra-voc:mechanicalCracks
    a skos:Concept ;
    skos:inScheme ocra-voc:CulturalHeritageAnnotationVocabulary ;
    skos:broader ocra-voc:cracks ;
    skos:prefLabel "Mechanical cracks"@en ;
    skos:prefLabel "Fessurazioni meccaniche"@it ;
    skos:scopeNote "Cracks caused primarily by mechanical stress, impact, bending, or structural tension."@en ;
    skos:scopeNote "Fessurazioni causate principalmente da sollecitazioni meccaniche, urti, piegature o tensioni strutturali."@it ;
    skos:exactMatch aat:300228353 ;
    ocra:defaultColor "#E74C3C"^^xsd:string .

ocra-voc:crackle
    a skos:Concept ;
    skos:inScheme ocra-voc:CulturalHeritageAnnotationVocabulary ;
    skos:broader ocra-voc:cracks ;
    skos:prefLabel "Crackle"@en ;
    skos:prefLabel "Crettatura"@it ;
    skos:scopeNote "Network of fine cracks, typically affecting a surface layer such as paint, glaze, or coating."@en ;
    skos:scopeNote "Rete di fessure sottili che interessa tipicamente uno strato superficiale come pittura, vetrina o rivestimento."@it ;
    skos:exactMatch aat:300228345 ;
    ocra:defaultColor "#E74C3C"^^xsd:string .

ocra-voc:holes
    a skos:Concept ;
    skos:inScheme ocra-voc:CulturalHeritageAnnotationVocabulary ;
    skos:broader ocra-voc:lossDamage ;
    skos:prefLabel "Holes"@en ;
    skos:prefLabel "Fori"@it ;
    skos:scopeNote "Openings that perforate the material, whether original, accidental, or caused by deterioration."@en ;
    skos:scopeNote "Aperture che perforano il materiale, siano esse originali, accidentali o dovute al degrado."@it ;
    skos:exactMatch aat:300458785 ;
    ocra:defaultColor "#E74C3C"^^xsd:string .

# -- Fractures --

ocra-voc:fracture
    a skos:Concept ;
    skos:inScheme ocra-voc:CulturalHeritageAnnotationVocabulary ;
    skos:broader ocra-voc:lossDamage ;
    skos:prefLabel "Fracture"@en ;
    skos:prefLabel "Frattura"@it ;
    skos:scopeNote "Structural break in the material involving partial or complete separation along a break line."@en ;
    skos:scopeNote "Rottura strutturale del materiale con separazione parziale o completa lungo una linea di frattura."@it ;
    ocra:defaultColor "#E74C3C"^^xsd:string .

ocra-voc:break
    a skos:Concept ;
    skos:inScheme ocra-voc:CulturalHeritageAnnotationVocabulary ;
    skos:broader ocra-voc:fracture ;
    skos:prefLabel "Break"@en ;
    skos:prefLabel "Rottura"@it ;
    skos:scopeNote "Fracture resulting in a clearly broken part or in the separation of the object into pieces."@en ;
    skos:scopeNote "Frattura che produce una parte chiaramente rotta o la separazione dell'oggetto in piu frammenti."@it ;
    ocra:defaultColor "#E74C3C"^^xsd:string .

ocra-voc:fragmentary
    a skos:Concept ;
    skos:inScheme ocra-voc:CulturalHeritageAnnotationVocabulary ;
    skos:broader ocra-voc:lossDamage ;
    skos:prefLabel "Fragmentary"@en ;
    skos:prefLabel "Frammentario"@it ;
    skos:scopeNote "State in which the object survives only in fragments or is markedly incomplete."@en ;
    skos:scopeNote "Stato in cui l'oggetto si conserva solo in frammenti o risulta marcatamente incompleto."@it ;
    ocra:defaultColor "#E74C3C"^^xsd:string .

# -- Loss / lacuna --

ocra-voc:materialLoss
    a skos:Concept ;
    skos:inScheme ocra-voc:CulturalHeritageAnnotationVocabulary ;
    skos:broader ocra-voc:lossDamage ;
    skos:prefLabel "Material loss"@en ;
    skos:prefLabel "Perdita di materiale"@it ;
    skos:scopeNote "General loss of original material from the object, including both localized lacunae and losses affecting recognizable parts."@en ;
    skos:scopeNote "Perdita generale di materiale originale dal manufatto, comprendente sia lacune localizzate sia perdite che interessano parti riconoscibili."@it ;
    ocra:defaultColor "#E74C3C"^^xsd:string .

ocra-voc:lacuna
    a skos:Concept ;
    skos:inScheme ocra-voc:CulturalHeritageAnnotationVocabulary ;
    skos:broader ocra-voc:materialLoss ;
    skos:prefLabel "Lacuna"@en ;
    skos:prefLabel "Lacuna"@it ;
    skos:exactMatch aat:300263354 ;
    skos:scopeNote "Localized loss of original material or surface that does not imply the absence of a distinct structural part of the object."@en ;
    skos:scopeNote "Perdita localizzata di materiale originale o di superficie che non implica l'assenza di una parte strutturale distinta dell'oggetto."@it ;
    ocra:defaultColor "#E74C3C"^^xsd:string .

ocra-voc:missingPart
    a skos:Concept ;
    skos:inScheme ocra-voc:CulturalHeritageAnnotationVocabulary ;
    skos:broader ocra-voc:materialLoss ;
    skos:prefLabel "Missing part"@en ;
    skos:prefLabel "Parte mancante"@it ;
    skos:scopeNote "Loss of a recognizable structural, morphological, or functional part of the object, such as a limb, handle, appliqué, or other identifiable component."@en ;
    skos:scopeNote "Perdita di una parte strutturale, morfologica o funzionale riconoscibile dell'oggetto, come un arto, un'ansa, un'applique o un altro componente identificabile."@it ;
    ocra:defaultColor "#E74C3C"^^xsd:string .

# -- Fire and burn damage --

ocra-voc:fireDamage
    a skos:Concept ;
    skos:inScheme ocra-voc:CulturalHeritageAnnotationVocabulary ;
    skos:broader ocra-voc:lossDamage ;
    skos:prefLabel "Fire damage"@en ;
    skos:prefLabel "Danno da fuoco"@it ;
    skos:scopeNote "Damage caused by direct exposure to fire, flames, or intense heat."@en ;
    skos:scopeNote "Danno causato da esposizione diretta al fuoco, alle fiamme o a calore intenso."@it ;
    ocra:defaultColor "#E74C3C"^^xsd:string .

ocra-voc:scorching
    a skos:Concept ;
    skos:inScheme ocra-voc:CulturalHeritageAnnotationVocabulary ;
    skos:broader ocra-voc:fireDamage ;
    skos:prefLabel "Scorching"@en ;
    skos:prefLabel "Bruciatura / annerimento da calore"@it ;
    skos:scopeNote "Burnt or heat-darkened surface produced by strong thermal exposure without full combustion of the object."@en ;
    skos:scopeNote "Superficie bruciata o annerita dal calore, prodotta da una forte esposizione termica senza completa combustione dell'oggetto."@it ;
    ocra:defaultColor "#E74C3C"^^xsd:string .

# -- Vandalism --

ocra-voc:graffiti
    a skos:Concept ;
    skos:inScheme ocra-voc:CulturalHeritageAnnotationVocabulary ;
    skos:broader ocra-voc:lossDamage ;
    skos:prefLabel "Graffiti"@en ;
    skos:prefLabel "Graffiti / vandalismo"@it ;
    skos:scopeNote "Intentional markings, inscriptions, or scratches added after the object's original production, often as vandalism."@en ;
    skos:scopeNote "Segni, iscrizioni o graffi intenzionali aggiunti dopo la produzione originaria dell'oggetto, spesso come atto vandalico."@it ;
    skos:exactMatch aat:300015613 ;
    ocra:defaultColor "#E74C3C"^^xsd:string .

# ============================================================
# SURFACE FEATURES (original + extended)
# ============================================================

ocra-voc:inscription
    a skos:Concept ;
    skos:inScheme ocra-voc:CulturalHeritageAnnotationVocabulary ;
    skos:broader ocra-voc:surfaceFeature ;
    skos:prefLabel "Inscription"@en ;
    skos:prefLabel "Iscrizione"@it ;
    skos:scopeNote "Written, incised, impressed, or otherwise recorded text visible on the object's surface."@en ;
    skos:scopeNote "Testo scritto, inciso, impresso o altrimenti registrato visibile sulla superficie dell'oggetto."@it ;
