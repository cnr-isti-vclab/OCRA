    skos:scopeNote "Decorazione formata inserendo un materiale diverso in cavita predisposte nella superficie."@it ;
    ocra:defaultColor "#9B59B6"^^xsd:string .

ocra-voc:filigree
    a skos:Concept ;
    skos:inScheme ocra-voc:CulturalHeritageAnnotationVocabulary ;
    skos:broader ocra-voc:decoration ;
    skos:prefLabel "Filigree"@en ;
    skos:prefLabel "Filigrana"@it ;
    skos:scopeNote "Decorative work made of fine metal wires arranged in delicate patterns and attached to a support."@en ;
    skos:scopeNote "Lavorazione decorativa realizzata con sottili fili metallici disposti in motivi delicati e applicati a un supporto."@it ;
    ocra:defaultColor "#9B59B6"^^xsd:string .

ocra-voc:niello
    a skos:Concept ;
    skos:inScheme ocra-voc:CulturalHeritageAnnotationVocabulary ;
    skos:broader ocra-voc:decoration ;
    skos:prefLabel "Niello"@en ;
    skos:prefLabel "Niello"@it ;
    skos:scopeNote "Black metallic sulfide inlay used to fill engraved lines or recessed decoration, especially on metal."@en ;
    skos:scopeNote "Intarsio nero a base di solfuri metallici usato per riempire linee incise o decorazioni ribassate, soprattutto su metallo."@it ;
    ocra:defaultColor "#9B59B6"^^xsd:string .

ocra-voc:enamel
    a skos:Concept ;
    skos:inScheme ocra-voc:CulturalHeritageAnnotationVocabulary ;
    skos:broader ocra-voc:decoration ;
    skos:prefLabel "Enamel"@en ;
    skos:prefLabel "Smalto"@it ;
    skos:scopeNote "Vitreous decorative layer fused to the surface, often colored and applied to metal."@en ;
    skos:scopeNote "Strato decorativo vetroso fuso alla superficie, spesso colorato e applicato su metallo."@it ;
    ocra:defaultColor "#9B59B6"^^xsd:string .

ocra-voc:cloisonné
    a skos:Concept ;
    skos:inScheme ocra-voc:CulturalHeritageAnnotationVocabulary ;
    skos:broader ocra-voc:enamel ;
    skos:prefLabel "Cloisonné"@en ;
    skos:prefLabel "Smalto cloisonné"@it ;
    skos:scopeNote "Enamel technique in which colored cells are defined by thin metal partitions before firing."@en ;
    skos:scopeNote "Tecnica a smalto in cui celle colorate sono delimitate da sottili partizioni metalliche prima della cottura."@it ;
    ocra:defaultColor "#9B59B6"^^xsd:string .

ocra-voc:champlevé
    a skos:Concept ;
    skos:inScheme ocra-voc:CulturalHeritageAnnotationVocabulary ;
    skos:broader ocra-voc:enamel ;
    skos:prefLabel "Champlevé"@en ;
    skos:prefLabel "Smalto champlevé"@it ;
