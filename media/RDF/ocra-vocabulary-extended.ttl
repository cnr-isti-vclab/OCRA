    skos:scopeNote "Tecnica a smalto in cui campi ribassati sono scavati o fusi nel supporto e poi riempiti di smalto."@it ;
    ocra:defaultColor "#9B59B6"^^xsd:string .

ocra-voc:relief
    a skos:Concept ;
    skos:inScheme ocra-voc:CulturalHeritageAnnotationVocabulary ;
    skos:broader ocra-voc:decoration ;
    skos:prefLabel "Relief"@en ;
    skos:prefLabel "Rilievo"@it ;
    skos:scopeNote "Decoration or imagery projecting from the background surface to create a raised effect."@en ;
    skos:scopeNote "Decorazione o immagine che sporge dal fondo per creare un effetto in rilievo."@it ;
