  <rdf:Description rdf:about="https://data.ocra.echoes.eu/heritage-entity/cmqeu7cr1000batte885ajo20">
    <rdf:type rdf:resource="http://isl.ics.forth.gr/ontology/echoes/HC1_Heritage_Entity"/>
    <rdfs:label>UC2 Lamina (complete)</rdfs:label>
    <dc:title>Lamina in argento con decorazione a rosette e disco solare (UC2 Lamina)</dc:title>
    <dc:description>Lamina punica in argento a spessore molto ridotto, lavorata a sbalzo (repoussé) e cesello/punzonatura, con rosette e iconografia egittizzante (disco solare affiancato da due urei). L&apos;ornamento, probabilmente ricavato dal ritaglio di un elemento piu grande, era cucito su una veste in lana con fili bianchi e porpora e svolgeva funzione di applique in contesto funerario di alto rango. Il reperto, databile tra la metà del IV e il III secolo a.C., proviene dalla Tomba della Dea Alata (Necropoli Punica di Sant&apos;Antioco).</dc:description>
    <dc:creator>Artigiano anonimo</dc:creator>
    <dc:subject>lamina decorata</dc:subject>
    <dc:date>Metà IV-III sec. a.C.</dc:date>
    <dc:type>manufatto metallico</dc:type>
    <dc:source>https://catalog.example.org/collections/punic-sardinia/items/UC2-LAMINA-SANTANTIOCO</dc:source>
    <dc:language>it</dc:language>
    <dc:coverage>Tomba della Dea Alata, Necropoli Punica di Sant&apos;Antioco (CA), Sardegna, Italia</dc:coverage>
    <dc:rights>Soprintendenza Archeologia, belle arti e paesaggio per la città metropolitana di Cagliari e le province di Oristano e Sud Sardegna</dc:rights>
    <hdto:HP1_has_digital_twin rdf:resource="http://echoes-eccch.eu/HDT/Dzj1WlNTo67"/>
  </rdf:Description>

