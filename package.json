{
  "name": "ocra-min",
  "version": "0.1.0",
  "private": true,
  "description": "OAuth2 PKCE Demo with React Frontend and Node.js Backend",
  "scripts": {
    "dev": "docker compose up -d",
    "dev:frontend": "cd frontend && npm run dev",
    "dev:backend": "cd backend && npm run dev",
    "build": "cd frontend && npm run build",
    "build:frontend": "cd frontend && npm run build",
    "clean": "docker compose down",
    "logs": "docker compose logs -f",
    "logs:backend": "docker compose logs -f backend",
    "logs:frontend": "docker compose logs -f app",
    "install:frontend": "cd frontend && npm install",
    "install:backend": "cd backend && npm install",
    "db:migrate": "cd backend && npx prisma migrate dev",
    "db:migrate:bare": "cd backend && npx prisma migrate dev",
    "db:migrate:compose": "cd backend && DATABASE_URL='postgresql://postgres:postgres@localhost:5432/oauth_demo?schema=public' DIRECT_URL='postgresql://postgres:postgres@localhost:5432/oauth_demo?schema=public' npx prisma migrate dev",
    "db:test:bootstrap": "bash scripts/bootstrap-test-db.sh",
    "db:generate": "cd backend && npx prisma generate",
    "db:studio": "cd backend && npx prisma studio",
    "db:reset": "cd backend && npx prisma migrate reset --force",
    "test": "cd backend && npm test -- src/test/comprehensive-workflow.e2e.test.ts",
    "test:watch": "cd backend && npm run test:watch",
    "test:ui": "cd backend && npm run test:ui",
    "test:coverage": "cd backend && npm run test:coverage",
    "services:start": "bash scripts/start-services.sh",
    "services:stop": "bash scripts/stop-services.sh",
    "mongo:init": "bash scripts/bootstrap-mongo.sh",
    "project-files:cleanup": "bash scripts/cleanup-orphan-project-files.sh"
  },
  "workspaces": [
    "shared",
    "frontend",
    "backend"
  ],
  "dependencies": {
    "fs-extra": "^11.3.2",
    "root": "^3.2.0",
    "three": "^0.180.0"
  },
  "devDependencies": {
    "@types/three": "^0.180.0",
    "@vitest/coverage-v8": "^4.0.16",
    "@vitest/ui": "^4.0.16",
    "vitest": "^4.0.16"
  },
  "overrides": {
    "three": "^0.180.0",
    "prisma": "5.18.0",
    "@prisma/client": "5.18.0"
  }
}
