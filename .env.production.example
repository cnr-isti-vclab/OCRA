# Production Environment Configuration Example
# Copy this file to .env.prod and use with: --env-file .env.prod
# e.g.: docker compose -f docker-compose.yml -f docker-compose.prod.yml --env-file .env.prod up -d --build

# Public server hostname (without scheme)
SERVER_HOST=ocra.mydomain.org

# Keycloak OAuth Configuration
PROVIDER_URL=https://ocra.mydomain.org/auth
REALM=demo
ISSUER=https://ocra.mydomain.org/auth/realms/demo
CLIENT_ID=react-oauth
REDIRECT_URI=https://ocra.mydomain.org
SCOPE=openid profile email

# Public API base exposed by the reverse proxy
VITE_API_BASE=https://ocra.mydomain.org

# CORS Configuration - Frontend URLs that can access the backend
CORS_ORIGINS=https://ocra.mydomain.org

# Force the canonical public server URL used by Swagger/OpenAPI.
# This avoids accidental http:// URLs when a proxy does not forward X-Forwarded-Proto reliably.
SWAGGER_PUBLIC_SERVER_URL=https://ocra.mydomain.org

# Database Configuration (usually don't need to change)
DATABASE_URL=postgresql://postgres:postgres@postgres:5432/oauth_demo
POSTGRES_DB=oauth_demo
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres

# Keycloak Admin Credentials
KEYCLOAK_ADMIN=admin
KEYCLOAK_ADMIN_PASSWORD=admin

# System Admin Email
SYS_ADMIN_EMAIL=admin@ocra.it

# Optional demo override: every authenticated user is treated as creator at runtime.
# Disable it by removing the variable or setting it to false.
# DEMO_ALL_USERS_CREATOR=true

# Optional: keep the temporary ECCCH debug operations panel hidden in production
# SHOW_ECCCH_DEBUG_OPERATIONS=false

# Optional: seed the Galassi demo project in production without creating demo users.
# Set DEMO_PROJECT_MANAGER_EMAIL to one of the users from backend/config/system-users.json.
# RUN_DEMO_PROJECT_SEED=true
# RUN_DEMO_USERS_SEED=false
# DEMO_PROJECT_MANAGER_EMAIL=real.creator@example.org
